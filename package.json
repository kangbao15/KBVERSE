{
  "name": "kbverse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@kbverse/web",
    "dev:server": "npm run dev --workspace=@kbverse/server",
    "build": "npm run build --workspaces --if-present"
  }
}
